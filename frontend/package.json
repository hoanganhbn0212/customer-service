{
  "name": "customer-service-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "gen:api": "openapi --input ../backend/src/main/resources/openapi/customer-service.yaml --output src/api --client fetch && node scripts/patch-openapi-base.js",
    "dev": "vite",
    "build": "vite build",
    "build:vercel": "node scripts/vercel-build.mjs && npm run gen:api && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "build:cap": "npm run gen:api && cross-env CAPACITOR=1 vite build",
    "cap:sync": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android:apk": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "vue": "^3.4.31",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "cross-env": "^7.0.3",
    "openapi-typescript-codegen": "^0.29.0",
    "vite": "^5.3.4"
  }
}
