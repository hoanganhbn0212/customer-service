# DNS: tạo bản ghi A trỏ DOMAIN → IP public của VPS
DOMAIN=app.example.com
ACME_EMAIL=admin@example.com

DB_USER=app
DB_PASSWORD=change-me-use-long-random-string

# Tạo secret: openssl rand -hex 32  (hoặc PowerShell: -join ((48..57)+(65..90) | Get-Random -Count 64 | % {[char]$_}))
JWT_SECRET=
JWT_EXPIRATION_SECONDS=86400
